{
  "name": "boar-desktop",
  "productName": "BOAR",
  "version": "0.1.2",
  "private": true,
  "description": "BOAR desktop: the Expo web build of the app inside Electron, native packages served by the main process.",
  "author": "Bielcx",
  "homepage": "https://github.com/Bielcx/boar-desktop",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json && node scripts/build-mcp.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.shims.json",
    "test": "vitest run",
    "build:web": "node scripts/run.mjs build-web",
    "dev": "node scripts/run.mjs dev",
    "start": "npm run build:main && electron .",
    "e2e": "npm run build:main && playwright test",
    "dist": "install-electron && npm run build:main && npm run build:web && electron-builder",
    "bench": "node bench/run.mjs",
    "bench:compare": "node bench/report.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@fugood/node-whisper-win32-x64": "1.1.3",
    "@fugood/whisper.node": "1.1.3",
    "@node-llama-cpp/win-x64": "3.21.1",
    "@node-llama-cpp/win-x64-vulkan": "3.21.1",
    "node-llama-cpp": "3.21.1",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "io.github.bielcx.boar",
    "productName": "BOAR",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "files": [
      "dist/**/*",
      "web-dist/**/*",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!node_modules/node-llama-cpp/templates",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders,wasm,iccs,standard_fonts,legacy/web,legacy/image_decoders}",
      "!node_modules/pdfjs-dist/legacy/build/{*.map,*.min.mjs,pdf.sandbox*}",
      "!node_modules/@fugood/whisper.node/{whisper.cpp,src,scripts,CMakeLists.txt,lib/*.ts}"
    ],
    "asarUnpack": [
      "node_modules/@node-llama-cpp/**",
      "node_modules/@fugood/node-whisper-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/icon.png",
      "artifactName": "BOAR-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "../assets/mascot/filhote.png",
        "to": "mascot.png"
      }
    ]
  }
}
