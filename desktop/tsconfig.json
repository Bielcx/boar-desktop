{
  // Main process + preload: compiled to dist/ and run by Electron (CommonJS, no "type": "module").
  // erasableSyntaxOnly: the same files run under plain `node file.ts` in tests (no enums/namespaces/param props).
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/main", "src/shared"]
}
