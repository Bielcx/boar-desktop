{
  "expo": {
    "name": "BOAR",
    "slug": "boar-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "team.sopa.boar",
      "buildNumber": "2",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "BOAR uses the microphone only while voice input is on, to turn your question into text on this device.",
        "NSSpeechRecognitionUsageDescription": "BOAR transcribes your voice question on this device. Audio is never sent to a server.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "BOAR uses your location, read on this device, to answer questions about places near you, such as restaurants in the city you are in. It is never sent anywhere."
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true,
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "team.sopa.aoair",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-dev-client",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17110D",
          "ios": {
            "image": "./assets/splash-icon-ios.png",
            "imageWidth": 360,
            "backgroundColor": "#17110D"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cba72560-8333-4fca-af84-f42d1c25abe3"
      }
    },
    "owner": "vaipraonde",
    "locales": {
      "en": "./locales/en.json",
      "pt": "./locales/pt.json"
    }
  }
}
